/**
 * Quizgrid board plus a room-coded buzzer.
 * Boards live in boards/ and are chosen with ?board=.
 * FTC BIOBUZZ is the default. Production deploys from main.
 */
{
	"name": "quizgrid",
	"main": "worker/room.js",
	"compatibility_date": "2026-10-06",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./",
		"binding": "ASSETS",
		"run_worker_first": ["/room"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "BUZZ_ROOM",
				"class_name": "BuzzRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BuzzRoom"]
		}
	]
}
